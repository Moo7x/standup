# Slack — Socket Mode app with scopes chat:write, chat:write.customize, app_mentions:read, commands.
# Interactivity must be enabled for the Approve / Cancel buttons.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

OPENAI_API_KEY=sk-...
# Optional model overrides (defaults: gpt-4.1-mini / gpt-4.1 / gpt-4.1-mini)
# ANALYST_MODEL=
# CTO_MODEL=
# COMMS_MODEL=

# GitHub PAT with issues read/write on GITHUB_REPO ("owner/name")
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/name

# Brevo — the single outbound email, sent only from the Approve button
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
CUSTOMER_EMAIL=          # where the approved email goes
FOUNDER_NAME=            # signs the customer email

DATABASE_URL=postgresql://...   # Neon
